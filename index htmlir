<style>
*{box-sizing:border-box}
body{
margin:0;
font-family:Arial,sans-serif;
background:#f5f6fa;
color:#222;
}
header{
background:#111827;
color:white;
padding:20px;
text-align:center;
}
.logo{font-size:25px;font-weight:bold;color:#fff}
header p{margin:7px 0 0;color:#d1d5db}
.container{
max-width:600px;
margin:20px auto;
padding:15px;
}
.card{
background:white;
border-radius:16px;
padding:20px;
box-shadow:0 3px 15px #0001;
}
.product-image{
width:100%;
border-radius:12px;
background:#e9edf5;
min-height:220px;
display:flex;
align-items:center;
justify-content:center;
font-size:100px;
}
h1{text-align:center;font-size:25px}
.description{
line-height:2;
text-align:center;
color:#555;
}
.price{
text-align:center;
font-size:30px;
font-weight:bold;
color:#e65b18;
margin:20px;
}
.features{
line-height:2.3;
background:#f7f7f7;
padding:15px;
border-radius:10px;
}
form{margin-top:25px}
input{
width:100%;
padding:14px;
margin:8px 0;
border:1px solid #ddd;
border-radius:8px;
font-size:16px;
}
button{
width:100%;
padding:16px;
background:#e65b18;
color:white;
border:0;
border-radius:10px;
font-size:19px;
font-weight:bold;
margin-top:12px;
cursor:pointer;
}
button:disabled{opacity:.6}
.delivery{
text-align:center;
color:green;
font-weight:bold;
margin:15px;
}
footer{
text-align:center;
padding:20px;
color:#777;
}
</style>
</head>

<body>

<header>
<div class="logo">Velora Markit</div>
<p>مرحبا بكم في متجرنا</p>
</header>

<div class="container">
<div class="card">

<div class="product-image">🥽</div>

<h1>نظارات الواقع الافتراضي VR Box</h1>

<p class="description">
اكتشف تجربة مشاهدة مختلفة مع نظارات الواقع الافتراضي VR Box.
استمتع بمشاهدة الفيديوهات والألعاب ثلاثية الأبعاد
باستعمال هاتفك المتوافق.
</p>

<div class="price">180 درهم فقط</div>

<div class="features">
<strong>مميزات المنتج:</strong><br>
✓ تجربة مشاهدة الواقع الافتراضي<br>
✓ مناسبة للفيديوهات والألعاب المتوافقة<br>
✓ تستعمل مع الهاتف المتوافق<br>
✓ سهلة الاستعمال
</div>

<p class="delivery">التوصيل مجاني</p>

<h2 style="text-align:center">اطلب الآن</h2>

<form id="orderForm">

<input name="name" placeholder="الاسم الكامل" required>

<input name="phone" type="tel"
placeholder="رقم الهاتف" required>

<input name="city" placeholder="المدينة" required>

<input name="address" placeholder="العنوان بالتفصيل" required>

<input name="quantity" type="number"
value="1" min="1" max="10" required>

<button type="submit" id="submitBtn">
تأكيد الطلب الآن
</button>

</form>

<p id="message" style="text-align:center"></p>

</div>
</div>

<footer>
Velora Markit © 2026
</footer>

<script>
const SCRIPT_URL =
"ضع_هنا_رابط_GOOGLE_APPS_SCRIPT_EXEC_القديم";

document.getElementById("orderForm")
.addEventListener("submit", async function(e){

e.preventDefault();

const btn=document.getElementById("submitBtn");
const msg=document.getElementById("message");

if(SCRIPT_URL.startsWith("ضع_هنا")){
msg.textContent="يجب ربط Google Sheets أولاً.";
return;
}

btn.disabled=true;
btn.textContent="جاري إرسال الطلب...";

const data={
name:this.name.value,
phone:this.phone.value,
city:this.city.value,
address:this.address.value,
product:"نظارات الواقع الافتراضي VR Box",
price:180,
quantity:this.quantity.value,
orderType:"Website"
};

try{
await fetch(SCRIPT_URL,{
method:"POST",
mode:"no-cors",
headers:{
"Content-Type":"text/plain;charset=utf-8"
},
body:JSON.stringify(data)
});

fbq('track','Lead');

msg.style.color="green";
msg.textContent="شكراً لك! تم إرسال طلبك بنجاح.";

this.reset();

}catch(error){
msg.style.color="red";
msg.textContent="وقع خطأ، المرجو المحاولة مرة أخرى.";
}

btn.disabled=false;
btn.textContent="تأكيد الطلب الآن";

});
</script>

</body>
</html>
